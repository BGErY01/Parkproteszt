<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="hu.parkolo.controller.MainController"
      alignment="CENTER"
      spacing="25"
      prefWidth="900"
      prefHeight="600"
      style="-fx-background-color: #172438;">

    <padding>
        <Insets top="40" right="60" bottom="40" left="60"/>
    </padding>

    <!-- Fejléc -->
    <VBox alignment="CENTER" spacing="10">

        <Label text="🚗 PARKOLÓMANAGER"
               style="-fx-font-size: 32px;
                      -fx-font-weight: bold;
                      -fx-text-fill: white;"/>

        <Label text="Parkolókezelő rendszer"
               style="-fx-font-size: 16px;
                      -fx-text-fill: #AABBD0;"/>

    </VBox>

    <Region VBox.vgrow="ALWAYS"/>

    <!-- Új cég regisztrálása -->
    <VBox alignment="CENTER"
          spacing="18"
          maxWidth="550"
          style="-fx-background-color: #263A54;
                 -fx-background-radius: 15;
                 -fx-padding: 30;">

        <Label text="Új cég regisztrálása"
               style="-fx-font-size: 23px;
                      -fx-font-weight: bold;
                      -fx-text-fill: white;"/>

        <Label text="Hozz létre egy új céget és állítsd be a parkolási adatait."
               wrapText="true"
               style="-fx-font-size: 14px;
                      -fx-text-fill: #C6D3E2;"/>

        <Button text="ÚJ CÉG HOZZÁADÁSA"
                onAction="#openAddCompany"
                prefWidth="250"
                prefHeight="45"
                style="-fx-background-color: #3478D4;
                       -fx-text-fill: white;
                       -fx-font-size: 14px;
                       -fx-font-weight: bold;
                       -fx-background-radius: 8;
                       -fx-cursor: hand;"/>

    </VBox>

    <!-- Meglévő cég -->
    <VBox alignment="CENTER"
          spacing="18"
          maxWidth="550"
          style="-fx-background-color: #263A54;
                 -fx-background-radius: 15;
                 -fx-padding: 30;">

        <Label text="Belépés meglévő cégbe"
               style="-fx-font-size: 23px;
                      -fx-font-weight: bold;
                      -fx-text-fill: white;"/>

        <Label text="Válassz egy már regisztrált céget a parkoló kezeléséhez."
               wrapText="true"
               style="-fx-font-size: 14px;
                      -fx-text-fill: #C6D3E2;"/>


        <Button text="CÉG KIVÁLASZTÁSA"
                onAction="#openSelectCompany"
                prefWidth="250"
                prefHeight="45"
                style="-fx-background-color: #168568;
               -fx-text-fill: white;
               -fx-font-size: 14px;
               -fx-font-weight: bold;
               -fx-background-radius: 8;
               -fx-cursor: hand;"/>


    </VBox>

    <Region VBox.vgrow="ALWAYS"/>

    <!-- Lábléc -->
    <Label text="ParkolóManager | SQLite adatbázis"
           style="-fx-font-size: 12px;
                  -fx-text-fill: #91A2B7;"/>

</VBox>
