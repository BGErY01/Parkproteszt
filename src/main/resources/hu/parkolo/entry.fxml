<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="hu.parkolo.controller.EntryController"
      alignment="CENTER"
      spacing="20"
      prefWidth="500"
      prefHeight="530"
      style="-fx-background-color: #172438;">

    <fx:define>
        <ToggleGroup fx:id="colorGroup"/>
    </fx:define>

    <padding>
        <Insets top="35" right="45" bottom="35" left="45"/>
    </padding>

    <Label text="AUTÓ BEHAJTÁSA"
           style="-fx-font-size: 26px;
                  -fx-font-weight: bold;
                  -fx-text-fill: white;"/>

    <Label text="Add meg a beérkező autó adatait!"
           style="-fx-text-fill: #AABBD0;"/>

    <VBox spacing="7">
        <Label text="Rendszám"
               style="-fx-text-fill: white;"/>

        <TextField fx:id="licensePlateField"
                   promptText="Például: ABC-123"/>
    </VBox>

    <VBox spacing="7">
        <Label text="Nemzetiség"
               style="-fx-text-fill: white;"/>

        <TextField fx:id="nationalityField"
                   promptText="Például: HU"/>
    </VBox>

    <VBox spacing="12">

        <Label text="Rendszámtábla színe"
               style="-fx-text-fill: white;"/>

        <HBox spacing="25" alignment="CENTER_LEFT">

            <RadioButton fx:id="whiteRadio"
                         text="Fehér"
                         toggleGroup="$colorGroup"
                         style="-fx-text-fill: white;"/>

            <RadioButton fx:id="yellowRadio"
                         text="Sárga"
                         toggleGroup="$colorGroup"
                         style="-fx-text-fill: white;"/>

            <RadioButton fx:id="greenRadio"
                         text="Zöld"
                         toggleGroup="$colorGroup"
                         style="-fx-text-fill: white;"/>

        </HBox>

    </VBox>

    <HBox alignment="CENTER" spacing="15">

        <Button text="Mégse"
                onAction="#cancel"
                prefWidth="120"
                prefHeight="42"/>

        <Button text="Behajtás rögzítése"
                onAction="#saveEntry"
                prefWidth="180"
                prefHeight="42"
                style="-fx-background-color: #168568;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;"/>

    </HBox>

</VBox>
