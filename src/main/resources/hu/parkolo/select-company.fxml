<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="hu.parkolo.controller.SelectCompanyController"
      alignment="CENTER"
      spacing="20"
      prefWidth="600"
      prefHeight="500"
      style="-fx-background-color: #172438;">

    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <Label text="CÉG KIVÁLASZTÁSA"
           style="-fx-font-size: 26px;
                  -fx-font-weight: bold;
                  -fx-text-fill: white;"/>

    <Label text="Válaszd ki, melyik parkolót szeretnéd kezelni!"
           style="-fx-text-fill: #AABBD0;"/>

    <ListView fx:id="companyList"
              VBox.vgrow="ALWAYS"
              prefHeight="300"
              style="-fx-background-radius: 8;"/>

    <HBox alignment="CENTER" spacing="15">

        <Button text="Vissza"
                onAction="#cancel"
                prefWidth="120"
                prefHeight="40"/>

        <Button text="Belépés"
                onAction="#enterCompany"
                prefWidth="150"
                prefHeight="40"
                style="-fx-background-color: #168568;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;"/>

    </HBox>

</VBox>
