<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="hu.parkolo.controller.DashboardController"
      spacing="30"
      style="-fx-background-color: #172438;">

    <padding>
        <Insets top="35" right="45" bottom="35" left="45"/>
    </padding>

    <VBox spacing="8">

        <Label text="PARKOLÓMANAGER"
               style="-fx-font-size: 16px;
                      -fx-text-fill: #60A5FA;"/>

        <Label fx:id="companyNameLabel"
               text="Cég neve"
               style="-fx-font-size: 32px;
                      -fx-font-weight: bold;
                      -fx-text-fill: white;"/>

        <Label text="Parkoló irányítópult"
               style="-fx-font-size: 16px;
                      -fx-text-fill: #AABBD0;"/>

    </VBox>

    <GridPane hgap="20" vgap="20">

        <columnConstraints>
            <ColumnConstraints percentWidth="50"/>
            <ColumnConstraints percentWidth="50"/>
        </columnConstraints>

        <VBox GridPane.columnIndex="0"
              GridPane.rowIndex="0"
              spacing="12"
              style="-fx-background-color: #263A54;
                     -fx-background-radius: 12;
                     -fx-padding: 25;">

            <Label text="Összes parkolóhely"
                   style="-fx-text-fill: #AABBD0;"/>

            <Label fx:id="totalSpacesLabel"
                   text="0"
                   style="-fx-font-size: 34px;
                          -fx-font-weight: bold;
                          -fx-text-fill: white;"/>

        </VBox>

        <VBox GridPane.columnIndex="1"
              GridPane.rowIndex="0"
              spacing="12"
              style="-fx-background-color: #263A54;
                     -fx-background-radius: 12;
                     -fx-padding: 25;">

            <Label text="Szabad parkolóhelyek"
                   style="-fx-text-fill: #AABBD0;"/>

            <Label fx:id="freeSpacesLabel"
                   text="0"
                   style="-fx-font-size: 34px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #34D399;"/>

        </VBox>

        <VBox GridPane.columnIndex="0"
              GridPane.rowIndex="1"
              spacing="12"
              style="-fx-background-color: #263A54;
                     -fx-background-radius: 12;
                     -fx-padding: 25;">

            <Label text="Aktívan parkoló autók"
                   style="-fx-text-fill: #AABBD0;"/>

            <Label fx:id="occupiedSpacesLabel"
                   text="0"
                   style="-fx-font-size: 34px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #FBBF24;"/>

        </VBox>

        <VBox GridPane.columnIndex="1"
              GridPane.rowIndex="1"
              spacing="12"
              style="-fx-background-color: #263A54;
                     -fx-background-radius: 12;
                     -fx-padding: 25;">

            <Label text="Mozgáskorlátozott helyek"
                   style="-fx-text-fill: #AABBD0;"/>

            <Label fx:id="disabilitySpacesLabel"
                   text="0"
                   style="-fx-font-size: 34px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #60A5FA;"/>

        </VBox>

    </GridPane>

    <VBox spacing="10"
          style="-fx-background-color: #263A54;
                 -fx-background-radius: 12;
                 -fx-padding: 25;">

        <Label text="Parkolási óradíj"
               style="-fx-text-fill: #AABBD0;"/>

        <Label fx:id="priceLabel"
               text="0 Ft / óra"
               style="-fx-font-size: 25px;
                      -fx-font-weight: bold;
                      -fx-text-fill: white;"/>

    </VBox>

    <HBox spacing="15" alignment="CENTER_LEFT">

        <Button text="🚗 AUTÓ BEHAJTÁSA"
                onAction="#openEntry"
                prefWidth="230"
                prefHeight="55"
                style="-fx-background-color: #168568;
                       -fx-text-fill: white;
                       -fx-font-size: 15px;
                       -fx-font-weight: bold;
                       -fx-background-radius: 8;
                       -fx-cursor: hand;"/>

    </HBox>

</VBox>
